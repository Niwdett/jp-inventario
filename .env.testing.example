APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Los feature tests corren sobre MySQL (no SQLite): el diseño de Fase 3
# usa DDL específico de MySQL — columna generada `activo` para los índices
# UNIQUE compatibles con soft-delete (Decisiones_Tecnicas_JP.md, bloque F1).
#
# Copiar a `.env.testing` y ajustar credenciales. Crear la BD antes:
#   CREATE DATABASE jp_inventario_testing CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jp_inventario_testing
DB_USERNAME=root
DB_PASSWORD=

BCRYPT_ROUNDS=4

CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
